<% if (typeof previewSrc !== 'undefined' && previewSrc && typeof trackJson !== 'undefined') { %>
<div class="custom-player custom-player--<%= typeof variant !== 'undefined' ? variant : 'card' %>" data-player data-track="<%= trackJson %>">
    <div class="player-bar">
        <button type="button" class="player-play-btn" aria-label="Reproducir preview">
            <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
            </svg>
            <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6 5h4v14H6V5zm8 0h4v14h-4V5z"/>
            </svg>
        </button>
        <div class="player-main">
            <div class="player-progress" role="group" aria-label="Progreso de reproducción">
                <div class="player-progress-track">
                    <div class="player-progress-fill"></div>
                    <div class="player-progress-buffer"></div>
                </div>
                <input type="range" class="player-seek" min="0" max="100" value="0" step="0.1" aria-label="Buscar en la pista">
            </div>
            <div class="player-meta">
                <span class="player-time player-time--current">0:00</span>
                <span class="player-time-sep">/</span>
                <span class="player-time player-time--duration">0:30</span>
            </div>
        </div>
    </div>
</div>
<% } %>
